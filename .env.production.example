DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret

ALLOWED_HOSTS=api.safernotes.com,127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=https://app.safernotes.com

POSTGRES_DB=safernotes
POSTGRES_USER=safernotes
POSTGRES_PASSWORD=replace-with-a-long-random-db-password
DATABASE_URL=postgres://safernotes:replace-with-a-long-random-db-password@postgres:5432/safernotes

REDIS_URL=redis://redis:6379/0

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.protonmail.ch
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@safernotes.com
EMAIL_HOST_PASSWORD=replace-with-proton-smtp-token
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Safernotes <noreply@safernotes.com>
APP_BASE_URL=https://app.safernotes.com

ATTACHMENT_BUCKET=
ATTACHMENT_ENDPOINT_URL=
ATTACHMENT_REGION=auto
ATTACHMENT_UPLOAD_URL_TTL_SECONDS=900
ATTACHMENT_DOWNLOAD_URL_TTL_SECONDS=900

BILLING_PROVIDER=manual
BILLING_API_KEY=
BILLING_API_BASE_URL=https://sandbox-api.paddle.com
BILLING_PRICE_IDS={}
BILLING_STORE_ID=
BILLING_VARIANT_IDS={}
BILLING_CHECKOUT_URLS={}
BILLING_PORTAL_URL=
BILLING_SUCCESS_URL=
BILLING_WEBHOOK_SECRET=replace-before-using-billing

SAFERNOTES_DATA_DIR=/opt/safernotes/data
SAFERNOTES_API_PORT=8000
