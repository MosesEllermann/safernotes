DJANGO_SETTINGS_MODULE=config.settings.local
# Local development generates a temporary key when this is empty.
SECRET_KEY=
DEBUG=True
# Leave unset to use local SQLite, or provide your own database URL.
# DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Safernotes <noreply@localhost>
APP_BASE_URL=http://localhost:3000
WEBSITE_BASE_URL=http://localhost:8080
# Local development stores attachments in backend/private-attachments/.
ATTACHMENT_UPLOAD_URL_TTL_SECONDS=900
ATTACHMENT_DOWNLOAD_URL_TTL_SECONDS=900
STORAGE_QUOTA_BYTES=0
