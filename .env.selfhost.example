# Run python3 tools/init_selfhost.py to create a private .env with random secrets.
# When configuring manually, fill both secrets before starting Docker.
SECRET_KEY=
POSTGRES_PASSWORD=
PUBLIC_URL=http://localhost:8080

SAFERNOTES_WEB_PORT=8080

# Optional operator-wide encrypted storage cap in bytes. 0 means unlimited.
STORAGE_QUOTA_BYTES=0

# Optional SMTP. Keep the console backend for a local-only stack, or uncomment
# and fill these values to send verification and recovery mail.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Safernotes <noreply@example.com>
