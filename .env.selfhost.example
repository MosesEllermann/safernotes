# Run python3 tools/init_selfhost.py to create a private .env with random secrets.
# When configuring manually, fill all three secrets before starting Docker.
SECRET_KEY=
POSTGRES_PASSWORD=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080
APP_BASE_URL=http://localhost:8080
WEBSITE_BASE_URL=http://localhost:8080

SAFERNOTES_WEB_PORT=8080
SAFERNOTES_API_PORT=8000

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=
ATTACHMENT_BUCKET=safernotes-local
ATTACHMENT_ENDPOINT_URL=http://localhost:9000
ATTACHMENT_REGION=us-east-1

# Optional operator-wide encrypted storage cap in bytes. 0 means unlimited.
STORAGE_QUOTA_BYTES=0

# Optional SMTP. Keep the console backend for a local-only stack, or uncomment
# and fill these values to send verification and recovery mail.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Safernotes <noreply@example.com>
